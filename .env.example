# npm run dev uses a local PostgreSQL database when DATABASE_URL is absent.
# Configure these only when using a separate database with a caidentia_app role.
# DATABASE_URL=postgresql://caidentia_app:SET_LOCALLY@127.0.0.1:5432/caidentia
# MIGRATION_DATABASE_URL=postgresql://postgres:SET_LOCALLY@127.0.0.1:5432/caidentia
APP_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
# No model service or model API key is needed.
